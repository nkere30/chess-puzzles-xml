<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans.xsd">
    <bean id="blackKingB" class="com.epam.rd.autotasks.chesspuzzles.ChessPieceImpl">
        <constructor-arg value="k"/>
        <constructor-arg>
            <bean class="com.epam.rd.autotasks.chesspuzzles.Cell" factory-method="cell">
                <constructor-arg value="B"/>
                <constructor-arg value="2"/>
            </bean>
        </constructor-arg>
    </bean>
    <bean id="blackBishopH" class="com.epam.rd.autotasks.chesspuzzles.ChessPieceImpl">
        <constructor-arg value="b"/>
        <constructor-arg>
            <bean class="com.epam.rd.autotasks.chesspuzzles.Cell" factory-method="cell">
                <constructor-arg value="H"/>
                <constructor-arg value="3"/>
            </bean>
        </constructor-arg>
    </bean>
    <bean id="whiteKingC" class="com.epam.rd.autotasks.chesspuzzles.ChessPieceImpl">
        <constructor-arg value="K"/>
        <constructor-arg>
            <bean class="com.epam.rd.autotasks.chesspuzzles.Cell" factory-method="cell">
                <constructor-arg value="C"/>
                <constructor-arg value="4"/>
            </bean>
        </constructor-arg>
    </bean>
    <bean id="blackPawnC" class="com.epam.rd.autotasks.chesspuzzles.ChessPieceImpl">
        <constructor-arg value="p"/>
        <constructor-arg>
            <bean class="com.epam.rd.autotasks.chesspuzzles.Cell" factory-method="cell">
                <constructor-arg value="C"/>
                <constructor-arg value="5"/>
            </bean>
        </constructor-arg>
    </bean>
    <bean id="whitePawnC" class="com.epam.rd.autotasks.chesspuzzles.ChessPieceImpl">
        <constructor-arg value="P"/>
        <constructor-arg>
            <bean class="com.epam.rd.autotasks.chesspuzzles.Cell" factory-method="cell">
                <constructor-arg value="D"/>
                <constructor-arg value="5"/>
            </bean>
        </constructor-arg>
    </bean>
    <bean id="blackPawnD" class="com.epam.rd.autotasks.chesspuzzles.ChessPieceImpl">
        <constructor-arg value="p"/>
        <constructor-arg>
            <bean class="com.epam.rd.autotasks.chesspuzzles.Cell" factory-method="cell">
                <constructor-arg value="D"/>
                <constructor-arg value="6"/>
            </bean>
        </constructor-arg>
    </bean>
    <bean id="whiteQueenA" class="com.epam.rd.autotasks.chesspuzzles.ChessPieceImpl">
        <constructor-arg value="Q"/>
        <constructor-arg>
            <bean class="com.epam.rd.autotasks.chesspuzzles.Cell" factory-method="cell">
                <constructor-arg value="A"/>
                <constructor-arg value="8"/>
            </bean>
        </constructor-arg>
    </bean>
</beans>